---
import Base from '../layouts/Base.astro';
import SculptureObject from '../components/SculptureObject.astro';
import { fallbackSculptures } from '../data/sculptures.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base route="/404" title="404 — dickheads">
  <section class="not-found">
    <div>
      <p>404 / OBJECT NOT FOUND</p>
      <h1>
        <span class="copy-de">DER WAR<br />WOHL NICHTS.</span>
        <span class="copy-en">THAT ONE<br />WENT NOWHERE.</span>
      </h1>
      <a class="button" href={`${base}/objects`}>
        <span class="copy-de">ZURÜCK ZU DEN OBJEKTEN</span>
        <span class="copy-en">BACK TO OBJECTS</span>
        <i>↗</i>
      </a>
    </div>
    <SculptureObject item={fallbackSculptures[27]} mode="404" />
  </section>
</Base>
