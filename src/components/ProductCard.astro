---
import SculptureObject from './SculptureObject.astro';
import type { Sculpture } from '../types';

interface Props {
  item: Sculpture;
  index?: number;
  featured?: boolean;
}

const { item, index = 0, featured = false } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/object/${item.slug}`;

const statusDe: Record<Sculpture['status'], string> = {
  available: 'ANFRAGE OFFEN',
  held: 'RESERVIERT',
  acquired: 'VERGEBEN'
};

const statusEn: Record<Sculpture['status'], string> = {
  available: 'INQUIRY OPEN',
  held: 'ON HOLD',
  acquired: 'ACQUIRED'
};
---

<a
  href={href}
  class:list={['product-card', featured && 'product-card--featured']}
  data-tilt-card
  data-status={item.status}
  style={`--delay:${Math.min(index * 45, 420)}ms`}
>
  <div class="product-visual">
    <div class="product-index">{String(index + 1).padStart(2, '0')}</div>
    <SculptureObject item={item} mode={featured ? 'feature' : 'card'} />
    <div class="product-orbit" aria-hidden="true"></div>
    <div class="product-reveal">
      <div>
        <span class="copy-de">{item.summaryDe}</span>
        <span class="copy-en">{item.summaryEn}</span>
      </div>
      <small>
        <span class="copy-de">OBJEKT ANSEHEN ↗</span>
        <span class="copy-en">VIEW OBJECT ↗</span>
      </small>
    </div>
  </div>
  <div class="product-meta">
    <div>
      <h3>{item.title}</h3>
      <p>{item.code} / {item.year}</p>
    </div>
    <div class:list={['availability', `availability--${item.status}`]}>
      <span class="copy-de">{statusDe[item.status]}</span>
      <span class="copy-en">{statusEn[item.status]}</span>
    </div>
  </div>
</a>
